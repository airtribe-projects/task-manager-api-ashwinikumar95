      "name": "Tasks",
      "item": [
        {
          "name": "POST Create task (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Task\",\n  \"description\": \"New Task Description\",\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "**201** — `title` and `description` required. Optional `priority`: `low` | `medium` | `high` (default **medium**). Server sets `completed: false` and `createdAt`."
          },
          "response": []
        },
        {
